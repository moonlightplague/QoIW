option(QOIW_CORE_SZ3 "Enable SZ3" ON)
option(QOIW_SZ3_USE_INSTALLED "Use an installed SZ3 CMake package" OFF)
set(QOIW_SZ3_SOURCE_DIR "" CACHE PATH "Alternative SZ3 checkout (defaults to the pinned submodule)")

function(qoiw_find_sz3)
    if(QOIW_SZ3_USE_INSTALLED)
        find_package(SZ3 3.4 CONFIG REQUIRED)
        return()
    endif()
    if(QOIW_SZ3_SOURCE_DIR)
        set(source_dir "${QOIW_SZ3_SOURCE_DIR}")
    else()
        set(source_dir "${QoIW_SOURCE_DIR}/SZ3")
    endif()
    if(NOT EXISTS "${source_dir}/CMakeLists.txt")
        message(FATAL_ERROR "Missing SZ3 at ${source_dir}. Run git submodule update --init SZ3 or set QOIW_CORE_SZ3=OFF.")
    endif()
    set(SZ3_INSTALL OFF)
    set(BUILD_SZ3_BINARY OFF)
    set(BUILD_MDZ OFF)
    set(BUILD_PARAVIEW_PLUGIN OFF)
    set(BUILD_H5Z_FILTER OFF)
    add_subdirectory("${source_dir}" "${QoIW_BINARY_DIR}/SZ3" EXCLUDE_FROM_ALL)
    # The dependency's headers are outside QoIW's warning policy.
    set_property(TARGET SZ3core APPEND PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
        "$<TARGET_PROPERTY:SZ3core,INTERFACE_INCLUDE_DIRECTORIES>")
endfunction()

if(QOIW_CORE_SZ3)
    qoiw_find_sz3()
endif()
