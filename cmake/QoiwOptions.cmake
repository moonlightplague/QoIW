option(QOIW_WARNINGS_AS_ERRORS "Treat QoIW compiler warnings as errors" OFF)
set(QOIW_SANITIZE "none" CACHE STRING "Sanitizer for QoIW targets")
set_property(CACHE QOIW_SANITIZE PROPERTY STRINGS none address undefined thread)
if(NOT QOIW_SANITIZE MATCHES "^(none|address|undefined|thread)$")
    message(FATAL_ERROR "Unknown QOIW_SANITIZE value: ${QOIW_SANITIZE}")
endif()

function(qoiw_configure_target target)
    target_compile_features(${target} PUBLIC cxx_std_17)
    target_include_directories(${target} PRIVATE "${QoIW_SOURCE_DIR}/src")
    if(CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math -ffp-contract=off)
        if(QOIW_WARNINGS_AS_ERRORS)
            target_compile_options(${target} PRIVATE -Werror)
        endif()
        if(NOT QOIW_SANITIZE STREQUAL "none")
            target_compile_options(${target} PRIVATE -fsanitize=${QOIW_SANITIZE} -fno-omit-frame-pointer)
            # Consumers of an instrumented static library also need its runtime.
            target_link_options(${target} PUBLIC -fsanitize=${QOIW_SANITIZE})
            if(QOIW_SANITIZE STREQUAL "undefined")
                target_compile_options(${target} PRIVATE -fno-sanitize-recover=undefined)
            endif()
        endif()
    elseif(QOIW_WARNINGS_AS_ERRORS OR NOT QOIW_SANITIZE STREQUAL "none")
        message(FATAL_ERROR "QoIW warning and sanitizer options require a GCC- or Clang-compatible compiler")
    endif()
endfunction()
